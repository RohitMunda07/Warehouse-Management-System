{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,

    "types": ["node", "express", "multer"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/emails/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
